# Copy to .env.local and fill in values. Never commit .env.local.
# Never put secret/service-role keys in VITE_* variables.
# See ENV_INVENTORY.md for the full list of variables and where they live.

# --- Option A: local Supabase (recommended for development) -----------------
# Run `supabase start` + `supabase db reset`, then copy the API URL and the
# publishable (anon) key from `supabase status`.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key-from-supabase-status>

# --- Option B: hosted Supabase project --------------------------------------
# Dashboard → Project Settings → API (publishable key only).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# --- CLI only (not read by Vite) ---------------------------------------------
# Used by `npm run supabase:link` for REMOTE-only workflows (deploying Edge
# Functions / pushing migrations to a hosted project). Not needed for local dev.
# Export in your shell or keep it here; the CLI/npm script does not read .env.local
# automatically, so run: export SUPABASE_PROJECT_REF=<project-ref>
# SUPABASE_PROJECT_REF=<project-ref>
