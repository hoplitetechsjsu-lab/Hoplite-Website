# Copy to supabase/.env (gitignored via the root `.env.*` rule) for local-only use.
# Nothing here is required for email/password local development.
#
# Edge Functions: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS, SUPABASE_SECRET_KEYS are
# injected automatically by `supabase start` / `supabase functions serve` and by the
# hosted platform. Do NOT add them here, and never commit real keys.
# Hosted function secrets: `supabase secrets set NAME=value` (not this file).

# Google OAuth (local = config/smoke only; hosted Google OAuth is mandatory and is
# verified in the hosted phase). config.toml reads the secret via env(...) when
# [auth.external.google] is enabled. Leave blank to keep Google disabled locally.
# The client id is set directly in config.toml ([auth.external.google].client_id);
# only the secret is read from the environment.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional: enables Supabase Studio AI assistant locally (referenced in config.toml).
OPENAI_API_KEY=
